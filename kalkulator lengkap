
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Digital</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #141e30, #243b55);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .calculator {
            width: 330px;
            background: #1c1c1c;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .display {
            width: 100%;
            height: 100px;
            background: #292929;
            color: white;
            border: none;
            outline: none;
            text-align: right;
            font-size: 35px;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .buttons {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        button {
            height: 60px;
            border: none;
            border-radius: 12px;
            font-size: 21px;
            cursor: pointer;
            background: #383838;
            color: white;
            transition: 0.2s;
        }

        button:hover {
            background: #555;
        }

        .operator {
            background: #ff9500;
        }

        .operator:hover {
            background: #e08700;
        }

        .special {
            background: #777;
            color: black;
        }

        .equal {
            background: #2196f3;
            grid-column: span 2;
        }

        .equal:hover {
            background: #0879d1;
        }

        .zero {
            grid-column: span 2;
        }
    </style>
</head>

<body>

    <div class="calculator">

        <input type="text" class="display"
            id="display" value="0" readonly>

        <div class="buttons">

            <button class="special" onclick="clearDisplay()">AC</button>
            <button class="special" onclick="deleteNumber()">DEL</button>
            <button class="special" onclick="percentage()">%</button>
            <button class="operator" onclick="chooseOperator('/')">÷</button>

            <button onclick="appendNumber('7')">7</button>
            <button onclick="appendNumber('8')">8</button>
            <button onclick="appendNumber('9')">9</button>
            <button class="operator" onclick="chooseOperator('*')">×</button>

            <button onclick="appendNumber('4')">4</button>
            <button onclick="appendNumber('5')">5</button>
            <button onclick="appendNumber('6')">6</button>
            <button class="operator" onclick="chooseOperator('-')">−</button>

            <button onclick="appendNumber('1')">1</button>
            <button onclick="appendNumber('2')">2</button>
            <button onclick="appendNumber('3')">3</button>
            <button class="operator" onclick="chooseOperator('+')">+</button>

            <button class="zero" onclick="appendNumber('0')">0</button>
            <button onclick="appendNumber('.')">.</button>
            <button class="equal" onclick="calculate()">=</button>

        </div>
    </div>

    <script>

        const display = document.getElementById("display");

        let firstNumber = null;
        let operator = null;
        let newNumber = true;

        function appendNumber(number) {

            if (newNumber) {
                display.value = number === "." ? "0." : number;
                newNumber = false;
                return;
            }

            if (number === "." && display.value.includes(".")) {
                return;
            }

            if (display.value === "0" && number !== ".") {
                display.value = number;
            } else {
                display.value += number;
            }
        }

        function chooseOperator(op) {

            if (operator !== null && !newNumber) {
                calculate();
            }

            firstNumber = parseFloat(display.value);
            operator = op;
            newNumber = true;
        }

        function calculate() {

            if (operator === null || firstNumber === null) {
                return;
            }

            let secondNumber = parseFloat(display.value);
            let result;

            switch (operator) {

                case "+":
                    result = firstNumber + secondNumber;
                    break;

                case "-":
                    result = firstNumber - secondNumber;
                    break;

                case "*":
                    result = firstNumber * secondNumber;
                    break;

                case "/":
                    if (secondNumber === 0) {
                        display.value = "Error";
                        firstNumber = null;
                        operator = null;
                        newNumber = true;
                        return;
                    }
                    result = firstNumber / secondNumber;
                    break;
            }

            display.value = String(
                Number(result.toPrecision(12))
            );

            firstNumber = null;
            operator = null;
            newNumber = true;
        }

        function clearDisplay() {
            display.value = "0";
            firstNumber = null;
            operator = null;
            newNumber = true;
        }

        function deleteNumber() {

            if (newNumber) return;

            display.value = display.value.slice(0, -1);

            if (display.value === "" || display.value === "-") {
                display.value = "0";
                newNumber = true;
            }
        }

        function percentage() {

            let number = parseFloat(display.value);

            display.value = String(number / 100);
            newNumber = true;
        }

    </script>

</body>
</html>
